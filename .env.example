# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (public / browser-safe) ---
# Project URL from Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable anon key. Safe to expose in the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
# Service role key. BYPASSES Row Level Security.
# NEVER prefix with NEXT_PUBLIC_ — server-only imports enforced by lint.
SUPABASE_SERVICE_ROLE_KEY=

# --- Session ---
# Minutes of user inactivity before client-side sign-out (PRD A4, default 480).
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=480
